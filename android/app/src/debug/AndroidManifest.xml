<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- El permiso INTERNET es necesario durante el desarrollo: la herramienta
         Flutter lo utiliza para comunicarse con la aplicación en ejecución,
         establecer puntos de interrupción y realizar recarga en caliente, etc.
         The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
